PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/streammind-ai

# JWT secret for auth tokens
JWT_SECRET=change_this_to_a_long_random_string

# Cloudinary (video/thumbnail uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ================= AI FEATURES =================
# Powers all AI features: video summaries, upload tag/category suggestions,
# the video Q&A chat, the site-wide chatbot, trending insights, and comment
# moderation (services/aiService.js).
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# ================= AUTO-SYNC FROM YOUTUBE =================
# Optional. Comma-separated YouTube channel IDs to automatically pull new
# videos from (via public RSS — no API key needed). Runs once at server
# startup and whenever POST /api/videos/auto-fetch is called. If left
# blank, a small default set of channels is used (see server/services/syncService.js).
YT_SYNC_CHANNEL_IDS=

# ================= LIVE YOUTUBE SEARCH =================
# Powers real-time search results (like YouTube/Instagram search) —
# whatever a user types is fetched live from YouTube itself, not just
# matched against videos already in the DB. Required for this; without
# it, search still works but only searches videos already in your DB.
#
# How to get one (free):
#   1. https://console.cloud.google.com/ -> create/select a project
#   2. APIs & Services -> Library -> enable "YouTube Data API v3"
#   3. APIs & Services -> Credentials -> Create Credentials -> API key
# Free tier: ~100 searches/day (10,000 quota units, 100 units/search).
YOUTUBE_API_KEY=

# ================= VEXA PREMIUM PAYMENTS (Razorpay) =================
# Powers real payment processing for Premium (UPI, cards, netbanking,
# wallets — Razorpay's checkout handles all of them in one widget).
#
# How to get keys (free, no KYC needed for Test Mode):
#   1. https://dashboard.razorpay.com/signup -> create an account
#   2. Make sure you're in "Test Mode" (toggle top-left of the dashboard)
#   3. Settings -> API Keys -> Generate Test Key
#   4. Paste both values below
#
# In Test Mode you can run a full, real checkout flow with zero real
# money using Razorpay's published test credentials:
#   Test UPI ID: success@razorpay
#   Test Card:   4111 1111 1111 1111, any future expiry, any CVV
# Switch to Live Mode keys (after Razorpay KYC) when you're ready to
# accept real payments — no code changes needed, just swap the keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ================= SECURITY =================
# The frontend's URL — CORS only allows browser requests from this
# origin (plus localhost:5173/3000 for local dev, always allowed).
# Set this to your real deployed frontend URL in production.
CLIENT_URL=http://localhost:5173

# Set to "production" on a real deployment. This hides internal error
# details (stack traces, raw DB error messages) from API responses —
# they're still logged server-side, just not sent to the client.
NODE_ENV=development
